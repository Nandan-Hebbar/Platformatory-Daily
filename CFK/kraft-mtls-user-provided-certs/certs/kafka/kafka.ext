authorityKeyIdentifier=keyid,issuer
basicConstraints=CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth, clientAuth
subjectAltName = @alt_names

[alt_names]
DNS.1 = kafka
DNS.2 = kafka.confluent
DNS.3 = kafka.confluent.svc
DNS.4 = kafka.confluent.svc.cluster.local
DNS.5 = kafka-0.kafka.confluent.svc.cluster.local
DNS.6 = kafka-1.kafka.confluent.svc.cluster.local
DNS.7 = kafka-2.kafka.confluent.svc.cluster.local
